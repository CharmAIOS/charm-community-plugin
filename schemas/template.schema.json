{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Charm Community Template Registry",
  "type": "object",
  "required": ["version", "templates"],
  "properties": {
    "version": {
      "type": "string"
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "files", "post_init_message"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "description": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "github_url": {
            "type": "string",
            "format": "uri"
          },
          "post_init_message": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "content"],
              "properties": {
                "path": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
