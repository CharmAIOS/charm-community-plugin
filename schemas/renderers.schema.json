{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Output Renderers Registry",
  "type": "object",
  "properties": {
    "renderers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The exact _charm_render_type emitted by the agent (e.g. CRYPTO_CHART)",
            "minLength": 1
          },
          "npm_package": {
            "type": "string",
            "description": "The NPM package name containing the default export React Component (e.g. charm-renderer-crypto)",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "github_url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": ["id", "npm_package", "description", "author"],
        "additionalProperties": false
      }
    }
  },
  "required": ["renderers"],
  "additionalProperties": false
}
